# Keep Godot's text-based project files consistent across operating systems.
* text=auto
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.svg text eol=lf

# Do not run line-ending conversion on binary game assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
